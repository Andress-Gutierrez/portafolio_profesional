# Plantilla de variables de entorno.
# Copiar a `.env` y completar. `.env*` está ignorado por Git, salvo este archivo.
# Detalle por entorno y configuración de Vercel: bitacora/portafolio_profesional/CONTEXTO.md

# --- Supabase (públicas: se incrustan en el bundle del navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Host oficial que el tracker acepta: solo el nombre, sin https:// ni barra final.
# En desarrollo y previews el tracker no dispara por diseño (DEC-014).
NEXT_PUBLIC_SITE_HOST=

# --- Resend (SECRETA: solo servidor, nunca con prefijo NEXT_PUBLIC_) ---
RESEND_API_KEY=
